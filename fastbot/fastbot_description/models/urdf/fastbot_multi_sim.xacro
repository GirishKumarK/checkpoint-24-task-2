<?xml version="1.0"?>
<robot name="fastbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_name" default="fastbot_X"/>
  <xacro:property name="general_robot_name" value="$(arg robot_name)"/>

  <!-- In your setup, $(find pkg) already points to the *share* directory -->
  <xacro:property name="desc_share"   value="$(find fastbot_description)"/>
  <xacro:property name="gazebo_share" value="$(find fastbot_gazebo)"/>

  <!-- Optional helper if you want absolute meshes -->
  <xacro:macro name="abs_mesh" params="rel">
    <mesh filename="${desc_share}/${rel}"/>
  </xacro:macro>

  <!-- Includes (now correct) -->
  <xacro:include filename="${desc_share}/models/urdf/materials.xacro"/>
  <xacro:include filename="${desc_share}/models/urdf/fastbot_body.xacro"/>

  <xacro:fastbot_body robot_name="$(arg robot_name)"/>

  <!-- Gazebo includes -->
  <xacro:include filename="${gazebo_share}/gazebo/fastbot_materials_multi.gazebo"/>
  <xacro:include filename="${gazebo_share}/gazebo/fastbot_physics_multi.gazebo"/>
  <xacro:include filename="${gazebo_share}/gazebo/fastbot_plugins_multi.gazebo"/>

  <xacro:fastbot_materials robot_name="$(arg robot_name)"/>
  <xacro:fastbot_physics   robot_name="$(arg robot_name)"/>
  <xacro:fastbot_plugins   robot_name="$(arg robot_name)"/>

</robot>
